{
  "name": "Attend Lens Email Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "absence-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "id": "node-webhook-trigger",
      "name": "Absence Email Webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"status\": \"success\",\n  \"message\": \"Absence email payload received by n8n workflow\",\n  \"timestamp\": \"{{ $now.toISOString() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        470,
        300
      ],
      "id": "node-respond-webhook",
      "name": "Respond 200 OK"
    },
    {
      "parameters": {
        "fromEmail": "Attend Lens <dust53419@gmail.com>",
        "toEmail": "={{ $json.body.to_email }}",
        "subject": "={{ $json.body.subject }}",
        "html": "={{ $json.body.html_body }}",
        "text": "={{ $json.body.body }}",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        700,
        300
      ],
      "id": "node-send-email-smtp",
      "name": "Send Email (SMTP / Gmail App Password)"
    }
  ],
  "connections": {
    "Absence Email Webhook": {
      "main": [
        [
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Respond 200 OK": {
      "main": [
        [
          {
            "node": "Send Email (SMTP / Gmail App Password)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "Attend Lens"
    }
  ]
}
