# Attend Lens Backend - Environment Variables
# Copy this file to .env and fill in your values.

DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/attendlens_db
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ATTENDANCE_THRESHOLD=75
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Gmail SMTP Credentials (for direct email sending)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Attend Lens

# n8n Webhook Integration (existing general webhook)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/absence-email

# n8n Absence-Email Webhook (attendance-absent flow)
# This is the webhook URL for the n8n workflow that sends Gmail
# notifications when a teacher saves attendance with absent students.
N8N_ABSENCE_WEBHOOK_URL=http://localhost:5678/webhook/attendance-absent

# Shared secret sent as X-Webhook-Secret header.
# Set the same value in the n8n Webhook node's Header Auth.
N8N_WEBHOOK_SECRET=change-this-to-a-random-secret-string

APP_BASE_URL=http://localhost:5173
EMAIL_AUTOMATION_ENABLED=true
EMAIL_DRY_RUN=false

# SMTP Fallback Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=attendance@attendlens.edu
FOLLOWUP_WAIT_HOURS=24
QUIET_HOURS_START=21
QUIET_HOURS_END=7
